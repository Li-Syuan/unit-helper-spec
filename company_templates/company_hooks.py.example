def identity_case(provider, expected_subject=None, rejected=False):
    """Optional helper: caller creates allowed/denied/disabled/expired providers.
    Company must also check Engine dispatch/scheduler gates and owner isolation.
    GatewayError must specifically represent expected authentication/authorization
    rejection; outages/timeouts must not be mapped to that rejection in the hook.
    """
    if rejected:
        raise NotImplementedError('Implement company-specific rejection-code assertions')
    identity = provider.current()
    if identity['subject'] != expected_subject or identity['mode'] == 'demo':
        raise ValueError('Unexpected company identity')
    return True


