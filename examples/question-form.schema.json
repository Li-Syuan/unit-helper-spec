{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnitHelper server QuestionForm",
  "description": "Server-created DTO, not an assistant response. Cross-field checks additionally enforce unique IDs, selection bounds, yes/no mapping, required semantics, owner, expiry and revision; no approval from a form answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task_id",
    "form_version",
    "purpose",
    "state",
    "expires_at",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "form_version": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "enum": [
        "collect_parameters",
        "offer_schedule"
      ]
    },
    "state": {
      "enum": [
        "open",
        "submitted",
        "expired",
        "cancelled"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "prompt",
          "required",
          "options",
          "min_selections",
          "max_selections",
          "allow_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "type": {
            "enum": [
              "yes_no",
              "single_choice",
              "multi_choice"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "min_selections": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "max_selections": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "allow_note": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
