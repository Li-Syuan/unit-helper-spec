{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnitHelper AssistantDecision",
  "description": "Self-defined adapter output. Parameters require a second validation against the authorized query template; never accept raw SQL. plan_draft is an untrusted proposal; server validates supported sequences and sources and owns approval.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "answer"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "rewrite"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "summarize"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "unsupported"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "missing_fields"
      ],
      "properties": {
        "kind": {
          "const": "clarify"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "missing_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "query_ref",
        "parameters"
      ],
      "properties": {
        "kind": {
          "const": "query_request"
        },
        "query_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "parameters": {
          "type": "object",
          "maxProperties": 20
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "goal",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "plan_draft"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "action",
                  "query_ref",
                  "parameters"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "action": {
                    "const": "query"
                  },
                  "query_ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "version"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "parameters": {
                    "type": "object",
                    "maxProperties": 20
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "action",
                  "source"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "action": {
                    "enum": [
                      "summarize",
                      "rewrite"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "message",
                          "upload",
                          "step"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
